#!/usr/bin/env ruby
# Load a local .env (e.g. PORT) for the dev server. The file is authoritative: its
# values override anything already in the environment, so the dev port is a single
# source of truth regardless of leftover shell vars.
env_file = File.expand_path("../.env", __dir__)
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    ENV[key] = value if key && value
  end
end

exec "./bin/rails", "server", *ARGV
